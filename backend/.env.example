# SparkIntellect Backend Environment Configuration Template
# DO NOT place actual secrets, private keys, or passwords in this template file.

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sparkintellect?retryWrites=true&w=majority

# Security Secrets (Generate using crypto.randomBytes(32).toString('hex'))
SESSION_SECRET=your_session_secret_min_32_characters_here
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d

# Resend Transactional Email Configuration (Domain: sparkintellect.in)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SparkIntellect <no-reply@sparkintellect.in>
CEO_NOTIFICATION_EMAIL=info@sparkintellect.in

# Cloudflare Turnstile CAPTCHA (Optional)
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_ENABLED=false

# Google Cloud (Service Account for Sheets & Google Drive Resume Storage)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Applications
# Google Drive Folder ID (e.g. My Drive > SparkIntellect Resume Storage > Production)
GOOGLE_DRIVE_RESUME_FOLDER_ID=

# File Uploads (Fallback & Limits)
UPLOAD_DIR=
MAX_FILE_SIZE_BYTES=5242880

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://sparkintellect.in,https://admin.sparkintellect.in
